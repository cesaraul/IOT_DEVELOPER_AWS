// PLANTILLA. Así es como tiene que quedar tu secretos.h.
//
// NO edites este archivo: edita el secretos.h que genera el script, o
// cópialo a secretos.h y rellénalo a mano si prefieres.
//
// La forma fácil, desde labs/03-iot-core:
//
//     docker compose run --rm aws python generar_secretos.py
//
// Ese script lee tu carpeta 'certificados' y escribe el secretos.h con los
// tres certificados ya pegados y con el formato correcto. Lo único que
// tienes que escribir tú es tu WiFi.
//
// POR QUÉ ESTO ESTÁ EN UN ARCHIVO APARTE
//   El ESP32 no tiene dónde guardar archivos sueltos: los certificados hay
//   que compilarlos DENTRO del programa, como texto. Eso crea un problema
//   que no teníamos en Python, donde la llave vivía en su propio archivo y
//   bastaba con no subir esa carpeta.
//
//   Si pegaras tu llave privada en el .ino, cualquiera que viera ese archivo
//   podría hacerse pasar por tu dispositivo. Y los .ino se comparten todo el
//   tiempo: por correo, en un USB, en un repositorio.
//
//   La solución es la de siempre: el código en un archivo, los secretos en
//   otro. El .ino se publica; el secretos.h está en el .gitignore y no sale
//   nunca de tu computadora.

#ifndef SECRETOS_H
#define SECRETOS_H

// --- Tu red WiFi -------------------------------------------------------
// El ESP32 solo habla WiFi de 2,4 GHz. Si tu router emite 2,4 y 5 GHz con
// el mismo nombre, puede que tengas que separarlos para que encuentre la red.
#define SECRETO_WIFI_SSID      "NOMBRE_DE_TU_WIFI"
#define SECRETO_WIFI_PASSWORD  "CLAVE_DE_TU_WIFI"

// --- Tu cuenta de AWS --------------------------------------------------
// El mismo endpoint que pusiste en el .env, y el nombre de tu objeto.
#define SECRETO_AWS_ENDPOINT   "a1b2c3d4e5f6g7-ats.iot.us-east-1.amazonaws.com"
#define SECRETO_DISPOSITIVO_ID "mi-dispositivo"

// --- Tus certificados --------------------------------------------------
// R"EOF( ... )EOF" es un 'raw string literal' de C++: todo lo que hay dentro
// se toma literal, con sus saltos de línea. Sin eso habría que escribir cada
// línea entre comillas y terminarla con \n, que es justo el tipo de tarea en
// la que uno se equivoca.
//
// PROGMEM le dice al compilador que guarde el texto en la memoria de
// programa (flash) y no en la RAM. Importa: los tres certificados juntos
// pasan de 4 KB, y el ESP32 necesita su RAM para la conexión TLS, que es cara.

// AmazonRootCA1.pem — este es público, el mismo para todo el mundo.
static const char SECRETO_ROOT_CA[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
...aquí van las líneas de AmazonRootCA1.pem...
-----END CERTIFICATE-----
)EOF";

// xxxxx.cert.pem — tu certificado: dice quién eres.
static const char SECRETO_CERTIFICADO[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
...aquí van las líneas de tu certificado...
-----END CERTIFICATE-----
)EOF";

// xxxxx.private.key — tu llave privada. ESTO es lo que no se comparte nunca.
static const char SECRETO_LLAVE_PRIVADA[] PROGMEM = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
...aquí van las líneas de tu llave privada...
-----END RSA PRIVATE KEY-----
)EOF";

#endif  // SECRETOS_H
