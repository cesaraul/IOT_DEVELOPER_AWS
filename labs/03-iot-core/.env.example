# Copia este archivo como .env y rellena los dos valores.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS y Linux:         cp .env.example .env

# El endpoint de TU cuenta. Consola de AWS IoT Core -> Settings ->
# "Device data endpoint". Es distinto para cada persona.
# Ejemplo: a1b2c3d4e5f6g7-ats.iot.us-east-1.amazonaws.com
AWS_IOT_ENDPOINT=

# El nombre que le pusiste a tu Thing en la consola.
DISPOSITIVO_ID=mi-dispositivo
