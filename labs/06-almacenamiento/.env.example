# Copia este archivo como .env y rellénalo.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS y Linux:         cp .env.example .env
#
# OJO: el archivo se llama .env, SIN el .example. El del .example es la
# plantilla que viene en el repositorio y sí se publica.

# ---------------------------------------------------------------------
# Las claves de tu usuario de IAM
# ---------------------------------------------------------------------
# Las mismas de los laboratorios anteriores. Si todavía no tienes
# usuario: docs/acceso-desde-tu-laptop.md
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# La región donde desplegaste la plantilla. Los recursos de una región
# no se ven desde otra, y ese es el despiste número uno.
AWS_REGION=us-east-2

# ---------------------------------------------------------------------
# Lo que creó la plantilla
# ---------------------------------------------------------------------
# El nombre de tu dispositivo, el mismo de las clases anteriores.
DISPOSITIVO_ID=mi-dispositivo

# La tabla y el bucket. Los dos salen en los Outputs al desplegar.
# Si los perdiste:
#   aws cloudformation describe-stacks --stack-name clase6 \
#     --query "Stacks[0].Outputs"
TABLA=mi-dispositivo-telemetria
BUCKET=
